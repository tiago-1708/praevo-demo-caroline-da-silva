# Referência das variáveis. Nunca preencher valores reais aqui.
# Copiar para .env.local para dev local. Em produção, definir nos
# secrets/variables do GitHub e/ou do Cloudflare Worker.

# --- Cliente (VITE_) — injectadas no bundle do browser ------------------

# Google Analytics 4 (opcional). Formato: G-XXXXXXX. Se vazio, GA não carrega.
VITE_GA_MEASUREMENT_ID=

# --- Servidor (Worker/Node) ---------------------------------------------
# Em dev local, exportar no ambiente do processo:
#   RESEND_API_KEY=re_xxx LEAD_DESTINATION_EMAIL=teste@exemplo.pt npm run dev

# Resend — API key com permissão Sending. https://resend.com/api-keys
RESEND_API_KEY=

# Destino das notificações do formulário de contactos
LEAD_DESTINATION_EMAIL=

# Endereço "From". Deixar vazio enquanto o domínio não estiver verificado
# no Resend — cai em onboarding@resend.dev (sandbox: só entrega ao email
# da conta Resend). Depois de verificar domínio, ex.:
#   LEAD_FROM_ADDRESS="Escritório <geral@advogado.pt>"
LEAD_FROM_ADDRESS=
